{
  "entry": "/",
  "title": "资源加速",
  "assets": ["/app.js", "/style.css"],
  "external_dependencies": [],
  "views": ["usage", "search", "tags", "offline"],
  "apis": ["/api/search", "/api/tags", "/api/offline/prepare"],
  "converter": {
    "input": "#convert-input",
    "output": "#convert-result",
    "copy": "#convert-copy",
    "scheme_normalization": "strip any leading scheme, then prefix window.location.origin",
    "supported_hosts": ["github.com", "gist.github.com", "api.github.com", "raw.githubusercontent.com", "objects.githubusercontent.com", "codeload.github.com", "github-releases.githubusercontent.com", "huggingface.co"]
  },
  "offline_fields": ["images", "platform", "compressed_layers"],
  "example_hosts": ["window.location.origin", "window.location.host"]
}
