{
  "entry": "/",
  "title": "资源加速",
  "assets": ["/app.js", "/style.css", "/ui-kit.js", "/ui-kit.css"],
  "external_dependencies": [],
  "views": ["usage", "mirrors"],
  "nav": ["用法", "镜像"],
  "mirror_sections": ["search", "tags", "offline"],
  "mirror_states": ["loading", "empty", "error", "ready"],
  "page_states": ["ui-loading", "ui-empty", "ui-error-state", "ui-skeleton"],
  "apis": ["/api/search", "/api/tags", "/api/offline/prepare", "/api/offline"],
  "converter": {
    "input": "#convert-input",
    "output": "#convert-result",
    "copy": "#convert-copy",
    "idle": "#convert-idle",
    "clipboard": "#convert-paste",
    "clear": "#convert-clear",
    "scheme_normalization": "strip any leading scheme, then prefix window.location.origin",
    "supported_hosts": ["github.com", "api.github.com", "codeload.github.com", "raw.githubusercontent.com", "gist.github.com", "gist.githubusercontent.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com", "github.githubassets.com", "huggingface.co"],
    "image_registries": ["docker.io", "ghcr.io", "gcr.io", "quay.io", "registry.k8s.io"],
    "formats": {
      "file": ["link", "curl", "wget"],
      "repo": ["clone", "link"],
      "image": ["pull", "ref"]
    }
  },
  "endpoint": {
    "host": "#current-host",
    "copy": "#copy-host",
    "value": "window.location.origin"
  },
  "capability_cards": [
    { "id": "cap-docker", "examples": ["docker-pull", "docker-mirror", "docker-ghcr"], "os_switch": ["linux", "windows", "macos"] },
    { "id": "cap-github", "examples": ["file-sample", "script-sample", "clone-sample"] },
    { "id": "cap-hf", "examples": ["hf-download", "hf-endpoint", "hf-clone"] },
    { "id": "cap-npm", "examples": ["npm-registry"] }
  ],
  "command_blocks": {
    "copy": [".snippet-copy", "#convert-copy", "[data-copy]"],
    "selection": ".snippet *::selection",
    "surface": "var(--ui-sunken)"
  },
  "offline_fields": ["images", "platform", "compressed_layers"],
  "offline_list": "#pack-list",
  "offline_preflight": "HEAD the prepared download_url (not consumed by HEAD); on failure HEAD /api/offline?image= per image",
  "theme": {
    "bootstrap": "/ui-kit.js",
    "mode": "standalone",
    "key": "accelerator-sources.theme",
    "order": ["saved accelerator-sources.theme", "prefers-color-scheme"]
  },
  "example_hosts": ["window.location.origin", "window.location.host"],
  "viewport": {
    "mobile_max_width": "480px",
    "tablet_max_width": "768px",
    "large_min_width": "1100px"
  }
}
