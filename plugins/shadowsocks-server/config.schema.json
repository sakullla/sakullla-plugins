{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["listeners"],
  "properties": {
    "generation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$",
      "description": "由宿主写入，不作为用户填写项。",
      "hostInjected": true
    },
    "resource_group_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$",
      "description": "由宿主写入，不作为用户填写项。",
      "hostInjected": true
    },
    "listeners": {
      "type": "array",
      "maxItems": 256,
      "default": [],
      "hostInjected": true,
      "description": "由插件管理页写入，不作为通用配置表单。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "agent_id", "port", "method", "users"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$",
            "description": "由宿主或插件写入，不作为用户填写项。",
            "hostInjected": true
          },
          "agent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "目标 Agent。由插件管理页写入，不作为通用配置表单。",
            "hostInjected": true
          },
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "method": {
            "enum": ["aes-128-gcm", "aes-256-gcm", "2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm"],
            "default": "2022-blake3-aes-128-gcm"
          },
          "server_secret_ref": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$",
            "description": "由宿主写入，不作为用户填写项。",
            "hostInjected": true
          },
          "server_secret_version": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$",
            "description": "由宿主写入，不作为用户填写项。",
            "hostInjected": true
          },
          "users": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "secret_ref", "secret_version", "enabled"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$",
                  "description": "由宿主或插件写入，不作为用户填写项。",
                  "hostInjected": true
                },
                "name": {"type": "string", "maxLength": 128},
                "secret_ref": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$",
                  "description": "由宿主写入，不作为用户填写项。",
                  "hostInjected": true
                },
                "secret_version": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$",
                  "description": "由宿主写入，不作为用户填写项。",
                  "hostInjected": true
                },
                "enabled": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "hostInjected": true,
      "default": {"upstreams": [], "rules": [], "default_action": "direct"},
      "required": ["upstreams", "rules", "default_action"],
      "properties": {
        "upstreams": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "host", "port", "method", "secret_ref", "secret_version", "enabled", "tcp", "udp"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$"},
              "host": {"type": "string", "minLength": 1, "maxLength": 253},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "method": {"enum": ["aes-128-gcm", "aes-256-gcm", "2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm"]},
              "secret_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$", "hostInjected": true},
              "secret_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$", "hostInjected": true},
              "enabled": {"type": "boolean"}, "tcp": {"type": "boolean"}, "udp": {"type": "boolean"}
            }
          }
        },
        "rules": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "source_id", "classification", "action"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$"},
              "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$"},
              "classification": {
                "type": "object", "additionalProperties": false, "required": ["name", "kind"],
                "properties": {
                  "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.!@+-]{0,127}$"},
                  "kind": {"enum": ["domain", "cidr", "country", "region"]},
                  "attributes": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "boolean": {"type": "boolean"}, "integer": {"type": "integer"}, "negate": {"type": "boolean"}}, "oneOf": [{"required": ["boolean"]}, {"required": ["integer"]}]}}
                }
              },
              "action": {"enum": ["direct", "reject", "upstream"]},
              "upstream_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$"}
            }
          }
        },
        "default_action": {"enum": ["direct", "reject", "upstream"]},
        "default_upstream_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$"}
      }
    }
  }
}
