{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakullla.dev/plugins/ip-policy/config.schema.json",
  "title": "IP 策略配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "default_action", "datasets", "province_whitelist", "rules"],
  "properties": {
    "schema": {"const": "sakullla.ip-policy/v1", "default": "sakullla.ip-policy/v1", "hostInjected": true},
    "default_action": {"type": "string", "enum": ["allow", "deny"], "default": "allow", "hostInjected": true},
    "datasets": {"type": "array", "maxItems": 4, "default": [], "hostInjected": true, "items": {"$ref": "#/$defs/dataset"}},
    "province_whitelist": {"type": "array", "maxItems": 31, "default": [], "hostInjected": true, "items": {"$ref": "#/$defs/classification_ref"}},
    "rules": {"type": "array", "maxItems": 256, "default": [], "hostInjected": true, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.!@+-]{0,127}$"},
        "kind": {"type": "string", "enum": ["cidr", "country", "region"]}
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_id", "classifications"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source_id": {"$ref": "#/$defs/id"},
        "classifications": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/classification"}}
      }
    },
    "classification_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "classification_id"],
      "properties": {"dataset_id": {"$ref": "#/$defs/id"}, "classification_id": {"$ref": "#/$defs/id"}}
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "selector"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "action": {"type": "string", "enum": ["allow", "deny"]},
        "selector": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "ip"}, "value": {"type": "string", "maxLength": 64}}},
            {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "cidr"}, "value": {"type": "string", "maxLength": 64}}},
            {"type": "object", "additionalProperties": false, "required": ["type", "dataset_id", "classification_id"], "properties": {"type": {"const": "classification"}, "dataset_id": {"$ref": "#/$defs/id"}, "classification_id": {"$ref": "#/$defs/id"}}}
          ]
        }
      }
    }
  }
}
