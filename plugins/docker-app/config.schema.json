{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apps"],
  "properties": {
    "apps": {
      "type": "array",
      "maxItems": 128,
      "default": [],
      "hostInjected": true,
      "description": "由插件管理页写入，不作为通用配置表单。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "compose", "generation"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
            "description": "由宿主写入，不作为用户填写项。",
            "hostInjected": true
          },
          "compose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576,
            "description": "一份 docker-compose YAML 对应一个应用。镜像与发布端口从 YAML 派生。"
          },
          "generation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "由宿主写入，不作为用户填写项。",
            "hostInjected": true
          },
          "secret_refs": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128},
            "description": "由宿主写入，不作为用户填写项。",
            "hostInjected": true
          },
          "auto_update": {
            "type": "boolean",
            "default": false,
            "description": "缺省关闭。仓库 digest 变化只提示有新版本，需手动更新。"
          }
        }
      }
    },
    "registry_mirror": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^$|^https://[A-Za-z0-9._~:\\[\\]-]+(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$",
      "description": "可选镜像加速。"
    },
    "resource_group_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{0,127}$",
      "description": "由宿主写入，不作为用户填写项。",
      "hostInjected": true
    }
  }
}
