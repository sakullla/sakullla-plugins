{
  "schema_version": 1,
  "title": "速率限制设置",
  "description": "本节点对 HTTP 和四层新建连接使用有界 GCRA 计数器放行",
  "components": [
    {
      "type": "section",
      "id": "general",
      "label": "本节点放行",
      "children": [
        {"type": "toggle", "id": "enabled", "label": "启用", "binding": "/enabled", "required": true},
        {"type": "number", "id": "max_keys", "label": "本节点最大键数", "binding": "/max_keys", "required": true, "minimum": 1, "maximum": 65536},
        {"type": "number", "id": "http_source_interval", "label": "HTTP 来源间隔（纳秒）", "binding": "/http/source/emission_interval_ns", "required": true, "minimum": 1, "maximum": 3600000000000},
        {"type": "number", "id": "http_source_burst", "label": "HTTP 来源突发", "binding": "/http/source/burst", "required": true, "minimum": 1, "maximum": 1000000},
        {"type": "toggle", "id": "http_global_enabled", "label": "HTTP 规则全局桶", "binding": "/http/global/enabled", "required": true},
        {"type": "number", "id": "l4_source_interval", "label": "四层新建连接间隔（纳秒）", "binding": "/l4/source/emission_interval_ns", "required": true, "minimum": 1, "maximum": 3600000000000},
        {"type": "number", "id": "l4_source_burst", "label": "四层新建连接突发", "binding": "/l4/source/burst", "required": true, "minimum": 1, "maximum": 1000000}
      ]
    },
    {
      "type": "notice",
      "id": "local_scope",
      "label": "单 Agent 本地计数",
      "description": "这些计数器在每个 Agent 上独立生效，不是用户、资源组、带宽或流量配额。",
      "tone": "info"
    },
    {
      "type": "notice",
      "id": "capability_gate",
      "label": "需要宿主能力",
      "description": "在宿主提供单调时钟和代际内原子状态变更前，安装会保持阻止。",
      "tone": "warning"
    }
  ],
  "actions": [
    {"type": "submit", "id": "save", "label": "保存"},
    {"type": "reset", "id": "reset", "label": "重置", "confirm": "重置速率限制设置和本地计数器？"}
  ]
}
